DATABASE_URL=

# Optional aliases used by some PostgreSQL hosts.
# DATABASE_URL is preferred.
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

NEXT_PUBLIC_APP_URL=

# Public browser key for the Google Maps Embed API used by Hotel Details.
# This is not an OAuth client secret. Restrict it in Google Cloud by HTTP
# referrer and enable only the Maps Embed API where possible.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=

AUTH_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public Google OAuth client identifier used only by the server-side native
# mobile token exchange at /api/mobile/v1/auth/google. This is the Web/server
# client whose audience Android and iOS Google ID tokens target. Keep it
# separate from the website NextAuth Google OAuth client above. It is not a
# secret and must not use a NEXT_PUBLIC_ or EXPO_PUBLIC_ prefix.
MOBILE_GOOGLE_WEB_CLIENT_ID=

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Google OAuth callbacks:
# Staging:
# https://staging.kurioticket.com/api/auth/callback/google
#
# Production:
# https://www.kurioticket.com/api/auth/callback/google
# https://kurioticket.com/api/auth/callback/google

RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=
NEWSLETTER_FROM_EMAIL=
NEWSLETTER_REPLY_TO=

# Authoritative server-side travel providers. Never expose these credentials through NEXT_PUBLIC_ variables.
TRAVEL_PROVIDER_MODE=local
ALLOW_SANDBOX_PROVIDERS=false

# Duffel is the only flight inventory source. Production must use live mode.
DUFFEL_API_MODE=live
DUFFEL_API_KEY=

# Cars are served by Kurioticket's approved static catalogue; no provider credentials are required.

ADMIN_EMAILS=admin@zentricresearch.com

# Temporary staging diagnostic toggle for /api/debug/request-location
ENABLE_REQUEST_LOCATION_DEBUG=false
REQUEST_LOCATION_DEBUG_TOKEN=

IPINFO_TOKEN=

# Server-side CurrencyFreaks FX rate provider. API secrets must stay server-side;
# the browser only calls Kurioticket's /api/currency/rates endpoint.
# FX_PROVIDER_API_KEY is server-side only. Do not prefix it with NEXT_PUBLIC_.
# FX_RATES_CRON_SECRET protects the scheduled sync endpoint. Configure Render Cron
# to call /api/internal/cron/currency-rates every 12 hours with this secret.
FX_PROVIDER_NAME=CurrencyFreaks
FX_PROVIDER_URL=https://api.currencyfreaks.com/v2.0/rates/latest?apikey={apiKey}&base={base}
FX_PROVIDER_API_KEY=
FX_RATE_CACHE_TTL_SECONDS=43200
FX_RATES_CRON_SECRET=

# Protects POST /api/internal/homepage-fares/refresh. Configure Render Cron
# with Authorization: Bearer <HOMEPAGE_FARES_CRON_SECRET>. Public homepage
# fare prices display only for provider-backed snapshots refreshed within 6
# hours. Schedule the cron target every 4 hours to keep the public display
# inside that 6-hour window.
HOMEPAGE_FARES_CRON_SECRET=

# Dedicated server-only AES-256-GCM key material for new account-security/TOTP writes (minimum 32 characters).
ACCOUNT_SECURITY_ENCRYPTION_KEY=
# Optional read-only key retained during v1 ciphertext rotation. Remove only after migration is verified.
ACCOUNT_SECURITY_LEGACY_ENCRYPTION_KEY=
