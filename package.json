{
  "name": "kurioticket",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "cross-env JITI_TSCONFIG_PATHS=true node --test --import jiti/register \"src/**/*.test.ts\"",
    "qa:ios:safari": "node qa/mobile-web/browserstack/run.mjs all",
    "qa:ios:safari:smoke": "node qa/mobile-web/browserstack/run.mjs smoke",
    "qa:ios:safari:cars": "node qa/mobile-web/browserstack/run.mjs cars",
    "qa:ios:safari:flights": "node qa/mobile-web/browserstack/run.mjs flights",
    "qa:ios:safari:flights:fixture": "node qa/mobile-web/browserstack/run-flight-fixture.mjs",
    "qa:ios:safari:flights:fixture:stress": "node qa/mobile-web/browserstack/run-flight-fixture.mjs stress-flights",
    "qa:ios:safari:hotels": "node qa/mobile-web/browserstack/run.mjs hotels",
    "qa:ios:safari:toolbar": "node qa/mobile-web/browserstack/selenium-toolbar.mjs",
    "qa:ios:safari:stress": "node qa/mobile-web/browserstack/run.mjs stress",
    "qa:ios:safari:stress:flights": "node qa/mobile-web/browserstack/run.mjs stress-flights",
    "qa:ios:safari:stress:hotels": "node qa/mobile-web/browserstack/run.mjs stress-hotels",
    "qa:mobile:local": "playwright test --config=qa/mobile-web/browserstack/local.playwright.config.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed:explore": "cross-env JITI_TSCONFIG_PATHS=true node --import jiti/register scripts/seed-explore-catalogue.ts",
    "catalog:airports:review": "node scripts/location-catalog-ingest.mjs",
    "db:studio": "prisma studio",
    "security:secrets": "node scripts/verify-no-secrets.mjs",
    "postinstall": "prisma generate",
    "db:deploy:render": "node scripts/run-render-migrations.mjs && node scripts/verify-production-schema.mjs",
    "check:conflicts": "node scripts/check-conflicts.mjs",
    "check:migration-timestamps": "node scripts/check-prisma-migration-timestamps.mjs",
    "prebuild": "npm run check:conflicts && npm run check:migration-timestamps",
    "check:homepage-destination-prices": "node scripts/check-homepage-destination-prices.mjs",
    "verify:currencies": "node scripts/verify-currency-coverage.mjs",
    "test:preview-release": "node --test services/preview-release/*.test.mjs",
    "preview-release:preflight": "node services/preview-release/preflight-cli.mjs",
    "preview-release:decision-trace": "node services/preview-release/decision-trace.mjs",
    "preview-release:adopt-native": "node services/preview-release/adopt-native-build.mjs",
    "preview-release:recover-native": "node services/preview-release/recover-native-build.mjs",
    "audit:i18n": "JITI_TSCONFIG_PATHS=true node scripts/audit-i18n-coverage-v4.mjs",
    "audit:images": "node scripts/audit-images.mjs",
    "audit:market-images": "node scripts/audit-market-images.mjs"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "google-auth-library": "^10.9.1",
    "lucide-react": "^1.14.0",
    "nanoid": "^5.1.11",
    "next": "^16.2.12",
    "next-auth": "^4.24.15",
    "pg": "^8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.3",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "browserstack-node-sdk": "^1.68.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "^16.2.12",
    "jiti": "^2.7.0",
    "prisma": "^7.9.1",
    "selenium-webdriver": "^4.48.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "@hono/node-server": "^2.0.12",
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.17"
    },
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.8"
    },
    "postcss": "^8.5.25",
    "sharp": "^0.35.3"
  }
}
