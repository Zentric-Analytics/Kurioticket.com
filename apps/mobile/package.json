{
  "name": "@kurioticket/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "npm run local:preview",
    "local:preview": "node ./scripts/start-local-preview.mjs",
    "android": "node ./scripts/start-local-preview.mjs --android",
    "ios": "node ./scripts/start-local-preview.mjs --ios",
    "web": "node ./scripts/start-local-preview.mjs --web",
    "typecheck": "tsc --noEmit",
    "test": "node --test --require ./testAssetSetup.cjs --import jiti/register \"src/**/*.test.ts\"",
    "expo:doctor": "expo-doctor",
    "release:validate": "node ./scripts/validate-release-policy.mjs",
    "release:classify": "node ./scripts/classify-release.mjs",
    "test:release-pipeline": "node --test ./scripts/release-pipeline.test.mjs"
  },
  "dependencies": {
    "expo": "^54.0.0",
    "expo-constants": "~18.0.10",
    "expo-crypto": "~15.0.9",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.8",
    "expo-updates": "~29.0.19",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-nitro-google-signin": "^1.0.2",
    "react-native-nitro-modules": "^0.36.3",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "expo-doctor": "^1.20.1",
    "jiti": "^2.7.0",
    "typescript": "~5.9.2"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-nitro-google-signin"
        ]
      }
    }
  }
}
