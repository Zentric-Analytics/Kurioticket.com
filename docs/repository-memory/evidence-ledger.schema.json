{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kurioticket.com/schemas/repository-memory-evidence-ledger.json",
  "type": "object",
  "required": ["schemaVersion", "records"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "claim", "scope", "evidence", "verification", "approval"],
        "properties": {
          "id": { "type": "string", "pattern": "^RM-[0-9]{4}-[0-9]{3}$" },
          "status": { "enum": ["active", "superseded", "disputed"] },
          "claim": { "type": "string", "minLength": 1 },
          "scope": { "type": "string", "minLength": 1 },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "reference"],
              "properties": {
                "kind": { "enum": ["commit", "pull-request", "test", "report", "external-observation"] },
                "reference": { "type": "string", "minLength": 1 },
                "note": { "type": "string" }
              }
            }
          },
          "verification": {
            "type": "object",
            "additionalProperties": false,
            "required": ["completed", "pending"],
            "properties": {
              "completed": { "type": "array", "items": { "type": "string" } },
              "pending": { "type": "array", "items": { "type": "string" } }
            }
          },
          "approval": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["state"],
                "properties": { "state": { "const": "not-recorded" } }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["state", "approver", "scope", "evidence"],
                "properties": {
                  "state": { "enum": ["approved", "rejected"] },
                  "approver": { "type": "string", "minLength": 1 },
                  "scope": { "type": "string", "minLength": 1 },
                  "evidence": { "type": "string", "minLength": 1 }
                }
              }
            ]
          },
          "supersededBy": { "type": "string", "pattern": "^RM-[0-9]{4}-[0-9]{3}$" }
        }
      }
    }
  },
  "additionalProperties": false
}
