flowchart TB
  GH[GitHub environments and secrets]
  EXPO[EAS-managed credentials]
  RENDER[Render environment variables]
  PLAY[Google Play signing keys]
  APPLE[ASC App Store Connect keys/certificates]

  CI[CI workflows] -->|use OIDC-restricted secrets| GH
  CI -->|EXPO_TOKEN| EXPO
  CI -->|database/env refs| RENDER
  EXPO -->|build signing| ANDROID_PREV[Android Preview keystore]
  EXPO -->|build signing| ANDROID_PROD[Android Production keystore]
  APPLE -->|distribution profile| IOS_PREV[iOS Preview cert/profile]
  IOS_PREV -->|TestFlight upload| ASC[Apple TestFlight]
  EXPO -->|submit + build artifacts| PUBLISH[Store artifacts]
  PUBLISH --> ANDROID_PREV
  PUBLISH --> IOS_PREV

